{
  "title": "MarkForMe Local AI Evaluation Case",
  "type": "object",
  "required": [
    "id",
    "title",
    "categories",
    "assignment",
    "rubric",
    "reviewedStudentText",
    "selectedConstraintIDs",
    "answerKeyText",
    "exemplarText",
    "curriculumReference",
    "ocrReviewStatus",
    "expected"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "categories": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "assignment": {
      "type": "object",
      "required": [
        "assignmentID",
        "title",
        "prompt",
        "subject",
        "gradeLevel",
        "className",
        "studentDisplayName",
        "assignmentType",
        "assessmentPurpose",
        "customInstructions",
        "formativeFocusText"
      ]
    },
    "rubric": {
      "type": "object",
      "required": ["criteria"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text", "maxPoints"]
          }
        }
      }
    },
    "reviewedStudentText": { "type": "string" },
    "reviewedTextWithSourceRefs": { "type": "string" },
    "selectedConstraintIDs": { "type": "array", "items": { "type": "string" } },
    "answerKeyText": { "type": "string" },
    "exemplarText": { "type": "string" },
    "curriculumReference": { "type": "string" },
    "ocrReviewStatus": { "type": "string" },
    "expected": {
      "type": "object",
      "required": [
        "mustNotContain",
        "mustContainTeacherReviewReasons",
        "maxAllowedPointsByCriterion",
        "requiresTeacherReview",
        "requiresPromptInjectionFlag",
        "requiresOCRReview",
        "requiresSourceReferences",
        "expectedConstraintIDs"
      ]
    }
  }
}
